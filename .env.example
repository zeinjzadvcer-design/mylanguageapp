# ─── Database ─────────────────────────────────────────────────────────────────
# Required. PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/ascension

# Connection pool tuning (see lib/db/src/index.ts for docs)
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_IDLE_TIMEOUT=30000
DB_CONN_TIMEOUT=5000

# ─── Session ──────────────────────────────────────────────────────────────────
# Required in production. Generate with: openssl rand -hex 64
SESSION_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET

# ─── First administrator (superuser) ──────────────────────────────────────────
# Registration only ever creates students and nothing promotes them, so an empty
# database has no way in. On start, the API creates ONE administrator from the
# values below.
#
# It happens once: if any administrator already exists, nothing is created. So
# promoting your own account and deleting this one is permanent — the default
# will not reappear on the next restart.
#
# Change these in the .env of whatever you are deploying to. The password has to
# pass the same rules a student's does: 8+ characters, at least one letter and
# one number.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin@1234

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080

# CORS: set to your deployed frontend URL in production (e.g. https://lughati.app).
# Leave unset in development to allow all origins.
ALLOWED_ORIGIN=

# Reverse proxy hops between client and Express (1 behind nginx/Cloudflare)
TRUST_PROXY=1

# ─── API reference (Swagger UI) ────────────────────────────────────────────────
# Browsable docs for the OpenAPI contract, served at /docs (and /api/docs, which
# also works through the web app's proxy). Defaults: on when NODE_ENV is not
# "production", off when it is. Set to true on a staging API so client developers
# can read and try the endpoints.
API_DOCS_ENABLED=

# ─── Logging ──────────────────────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ─── Redis ────────────────────────────────────────────────────────────────────
# REQUIRED for any AI feature. The AI quota counter fails CLOSED when Redis is
# unavailable — deliberately, so a cache outage cannot hand out unlimited paid
# AI — which means every AI call is refused without it.
#
# Leave unset only if AI is switched off: the app still runs, with an in-process
# cache (single-server only) and per-process rate limits.
# Set for multi-instance deployments, shared rate limiting, and AI quota enforcement.
#
# Supported URL formats:
#   redis://[:password@]host:6379[/db]
#   rediss://[:password@]host:6380[/db]   ← TLS (recommended for production)
#
# Recommended Redis settings (in redis.conf or cloud provider dashboard):
#   maxmemory 256mb
#   maxmemory-policy allkeys-lru   ← evict LRU keys when memory is full
REDIS_URL=

# Redis client timeouts (milliseconds)
REDIS_CONNECT_TIMEOUT=3000
REDIS_CMD_TIMEOUT=1000

# ─── Rate limiting ─────────────────────────────────────────────────────────────
# When Redis is configured, rate limit counters are shared across all instances.
# When Redis is absent, counters are per-instance (fine for single-server dev).
RATE_LIMIT_WINDOW_MS=900000    # 15 minutes
RATE_LIMIT_API=600             # general API, per signed-in user (all /api routes)
RATE_LIMIT_AUTH=10             # auth endpoints (login, register) — failed attempts only
RATE_LIMIT_PRACTICE_POLL=2400  # voice-practice polling, per student (status + signals, each 1/s during a call)

# ─── Email / password reset ───────────────────────────────────────────────────
# Where the reset link in a password-recovery email should point — the address
# students use, not this server. Without it the link is relative and unusable.
APP_BASE_URL=http://localhost:5173

# Which mail provider actually sends. Left blank (or "log"), nothing is sent:
# the message goes to the log, and OUTSIDE PRODUCTION the reset endpoint also
# returns the link in its response so development can continue. In production
# that fallback is off, so an unset provider means password reset silently does
# nothing for the student — set this before taking real signups.
#
#   resend  — https://resend.com   3,000/month free, 100/day
#   brevo   — https://brevo.com    300/day free
#   log     — write to the log (the default)
MAIL_PROVIDER=

# The sending address. Either `you@example.com` or `Name <you@example.com>`.
# The domain has to be verified with the provider or it will refuse the send.
MAIL_FROM=

# The provider's API key.
MAIL_API_KEY=

# How long to wait on the provider before giving up on one message.
MAIL_TIMEOUT_MS=10000

# No mail provider is wired up yet. Until one is, a reset email is written to
# the log instead of sent, and in development the link is also returned in the
# response so the flow can be completed. See services/mailer.ts.

# ─── Media storage (S3-compatible) ────────────────────────────────────────────
# Leave STORAGE_BUCKET unset to run without storage: the app starts fine and
# every non-audio feature works, but recording upload and playback return 503.
#
# Local:      MinIO via docker compose (see docker-compose.yml)
# Production: Cloudflare R2 (preferred — zero egress) or DigitalOcean Spaces.
#
# R2:     STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#         STORAGE_REGION=auto            ← R2 requires exactly this
#         STORAGE_FORCE_PATH_STYLE=false
# Spaces: STORAGE_ENDPOINT=https://<region>.digitaloceanspaces.com
#         STORAGE_REGION=<region>
# MinIO:  STORAGE_FORCE_PATH_STYLE=true  ← MinIO has no bucket subdomains
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false

# Only needed when the browser reaches storage at a different address than this
# server does — i.e. the API is in a container talking to MinIO by service name
# while the browser uses localhost. Presigned URLs are signed against this
# address, because SigV4 signs the Host header and a URL rewritten afterwards
# would fail its own signature. Leave unset for R2/Spaces.
STORAGE_PUBLIC_ENDPOINT=

# Recordings one student may start per rolling 24 hours.
MEDIA_DAILY_UPLOAD_LIMIT=200

# How many times one block may be answered in a lesson. Three covers the retry
# the 75% pass gate assumes and the cost model prices; past that the student is
# guessing at a grader and spending an AI allowance they will want later.
# Passive blocks (text, explanation, review) are exempt.
MAX_BLOCK_ATTEMPTS=3

# ─── AI ───────────────────────────────────────────────────────────────────────
# There is deliberately no provider URL, API key, model id or per-plan limit
# here. All of that lives in the database and is edited at runtime from the
# admin panel (/admin/ai), so switching provider or pricing a tier needs no
# redeploy. See docs/features/ai-configuration.md.
#
# The ONE thing that must be an environment variable is the secret used to
# encrypt stored API keys. Without it the panel refuses to store a key at all,
# rather than writing one in plaintext.
#   openssl rand -hex 32
AI_CONFIG_SECRET=

# How long to wait on a provider before giving up. AI must never hold a
# student's lesson open indefinitely.
AI_REQUEST_TIMEOUT_MS=30000

# How many times a failed provider call is retried before giving up. Bounds
# cost as well as latency: a provider having a bad day multiplies spend without
# producing output.
AI_MAX_ATTEMPTS=3

# Speech recognition has two separate clocks. The first bounds one HTTP request
# to the transcriber; the second bounds the whole wait for a transcript, which
# is a polling loop because transcription is a job rather than a response.
#
# The poll default in code is 180000 (3 min), sized for a 30-second read-aloud.
# A 15-minute multichannel peer call is a different shape of work — two
# channels, plus queue time before it starts — so a deployment that evaluates
# calls must raise this or long calls fail with a timeout after the student
# asked for feedback.
AI_ASR_TIMEOUT_MS=60000
AI_ASR_POLL_TIMEOUT_MS=600000

# ─── Grading recovery ─────────────────────────────────────────────────────────
# Work AI could not mark stays 'pending' rather than being marked wrong. A
# sweeper retries it, and what it gives up on goes to the marking queue at
# /cms/grading. Without this, a restart or an AI outage strands an answer
# permanently — and a level evaluation holds its promotion until every question
# has a verdict, so the student is stuck rather than failed.
GRADING_SWEEP_ENABLED=true
GRADING_SWEEP_INTERVAL_MS=600000      # look every 10 minutes
GRADING_SWEEP_STALE_MS=300000         # ignore work younger than 5 minutes
GRADING_SWEEP_MAX_ATTEMPTS=3          # then escalate to a human
GRADING_SWEEP_BATCH=20                # items per pass

# ─── Background jobs ──────────────────────────────────────────────────────────
# 'memory' runs jobs in this process with setImmediate: a job not finished is
# LOST on restart, and the deployment is capped at ONE instance, because a
# second would not share the work and both would sweep the same rows.
#
# 'bullmq' puts them in Redis — durable across restarts and claimed once
# cluster-wide, which is what makes more than one instance correct. Needs
# REDIS_URL, and the Redis/Valkey eviction policy must be `noeviction` or
# queued jobs can be evicted under memory pressure with no error at all.
JOB_QUEUE=memory

# How many jobs one process runs at once. Small on purpose: a job spends most
# of its life WAITING on a speech recogniser or a model, but it holds a
# database connection while it waits, and DB_POOL_MAX is per process. Too many
# starves the HTTP requests sharing that pool.
JOB_CONCURRENCY=4

# Retries per job. Low on purpose: the grading sweeper is already a recovery
# path with its own attempt limit, and retrying hard here as well multiplies
# paid AI calls against a provider having a bad day.
JOB_ATTEMPTS=2

# 'off' produces jobs without consuming them — what the web instances need once
# a separate worker deployment exists. Leave blank while one process does both.
JOB_WORKER=

# How long to spend finishing in-flight work on SIGTERM before exiting anyway.
# The platform kills the container shortly after signalling, so a shutdown that
# hangs waiting drains nothing at all.
SHUTDOWN_TIMEOUT_MS=15000

# ─── Student-to-student voice practice ────────────────────────────────────────
# Live voice calls between two learners (spec section 11). The audio is
# peer-to-peer and never reaches this server; what the server does is match
# people, carry the WebRTC handshake, and enforce the bounds below.

# Calls one student may be part of per rolling 24 hours. Abuse control, not
# cost control — a practice call costs nothing per minute.
PRACTICE_DAILY_CALL_LIMIT=20

# The server ends a call past this, whatever the two browsers think.
#
# 15, not 30. Two reasons, and the first is a hard limit: a call recording is
# uploaded for evaluation through the media pipeline, which caps a call
# recording at 960s (16 min) — so a longer call could never be evaluated.
# Second, 15 minutes costs about $0.086 of ASR and analysis against $0.111 at
# 20, so the `general_english` allowance of 60 monthly minutes buys a student
# four evaluated calls instead of three.
#
# The real exposure control is `ai_plan_policies.monthly_minutes`, not this: a
# per-call cap cannot express a monthly budget.
PRACTICE_MAX_CALL_MINUTES=15

# How long a proposed pairing rings before it is given up on.
PRACTICE_RING_TIMEOUT_MS=45000

# How long the two browsers get to establish the connection before the call is
# declared failed. Without a TURN relay (below) some pairs never connect at
# all, and a screen that says "connecting…" forever is the worst way to say so.
PRACTICE_CONNECT_TIMEOUT_MS=30000

# A call is normally ended by whichever side hangs up, and the length cap is
# enforced on the polling path — both of which need someone to still be
# polling. When nobody is (a crashed tab, a closed laptop, a dead battery) the
# call stays open, and the one-live-per-person rule then locks BOTH students out
# of starting another one.
#
# So presence is recorded per side on each poll, and a call both sides have
# stopped polling is closed. 30s is ten missed polls — a departure, not a slow
# network. Swept every 15s because the cost of being late is two students
# unable to practise, and the query is one indexed lookup.
PRACTICE_ABANDONED_AFTER_MS=30000
PRACTICE_SWEEP_INTERVAL_MS=15000

# STUN lets a browser discover its own public address. Free and low-traffic;
# these defaults are Google's public servers. Leave unset to use them.
PRACTICE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN relays the audio when the two ends cannot reach each other directly —
# strict NAT, mobile networks, corporate firewalls. WITHOUT IT ROUGHLY 10–20%
# OF CALLS WILL NOT CONNECT. It is unset on purpose (see
# docs/features/voice-practice.md); setting these three switches it on with no
# code change, and the credentials stay server-side.
PRACTICE_TURN_URLS=
PRACTICE_TURN_USERNAME=
PRACTICE_TURN_CREDENTIAL=
