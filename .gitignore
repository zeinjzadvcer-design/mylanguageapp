# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Local caches
.cache/
.local/

# Local env
.env
# Backups made while editing .env hold the same secrets the file does.
.env.bak*
.env.local
.env.*.local

# Per-machine compose overrides. The file in this repo says so itself: it
# carries local networking workarounds (DNS resolvers, IPv4-first, a substitute
# image) that would be wrong on anyone else's machine and on every deployment.
docker-compose.override.yml

# Backups made while editing .env hold the same secrets the file does.
.env.bak*
.env.local
.env.*.local

# Loose notes, credentials and documents
#
# These accumulate at the repo root during development — API keys pasted into a
# file, deployment notes, exported PDFs. None of it belongs in version control,
# and a blanket rule is safer than remembering to ignore each one.
*.txt
*.pdf

# robots.txt is served by the web app, so it has to stay tracked.
!artifacts/ascension/public/robots.txt

# Per-machine compose overrides. The file in this repo says so itself: it
# carries local networking workarounds (DNS resolvers, IPv4-first, a substitute
# image) that would be wrong on anyone else's machine and on every deployment.
docker-compose.override.yml

# The stray NUL that Windows shell redirection leaves behind.
NUL

# Hand-made test payloads for the SMS ingest; they carry a live token.
sms.json
